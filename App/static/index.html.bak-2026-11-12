<script>
(function(){
var D=null, S={nav:'home',view:'list',filter:'all',month:null,sel:null};
try{var sv=JSON.parse(localStorage.getItem('orbitus-ui')||'{}');S.view=sv.view||S.view;S.filter=sv.filter||S.filter}catch(e){}
function save(){try{localStorage.setItem('orbitus-ui',JSON.stringify({view:S.view,filter:S.filter}))}catch(e){}}
var $=function(id){return document.getElementById(id)};
function esc(s){return String(s==null?'':s).replace(/[&<>"']/g,function(c){return{'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]})}
function toast(m){var t=$('toast');t.textContent=m;t.style.display='block';clearTimeout(toast.h);toast.h=setTimeout(function(){t.style.display='none'},3200)}
var MES=['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];
var DS=['Domingo','Segunda','Terça','Quarta','Quinta','Sexta','Sábado'];
function pd(s){var p=s.split('-');return new Date(+p[0],+p[1]-1,+p[2])}
function key(d){return d.getFullYear()+'-'+String(d.getMonth()+1).padStart(2,'0')+'-'+String(d.getDate()).padStart(2,'0')}

var ICON={mesa:'M3 10h18M5 10v9M19 10v9M8 6h8l3 4H5z',home:'M3 11.5L12 4l9 7.5M5.5 9.8V20h13V9.8',tasks:'M9 6h11M9 12h11M9 18h11M4 6l1 1 2-2M4 12l1 1 2-2M4 18l1 1 2-2',train:'M3 9v6M6 7v10M18 7v10M21 9v6M6 12h12',wealth:'M5 19V12M10 19V8M15 19v-5M20 19V5',cal:'M4 7h16v13H4zM4 11h16M8 4v4M16 4v4',mail:'M3.5 6.5h17v11h-17zM4 7l8 6 8-6',goals:'M12 21a9 9 0 1 0 0-18 9 9 0 0 0 0 18zM12 16a4 4 0 1 0 0-8 4 4 0 0 0 0 8z',trip:'M2.5 15l19-6.5-3-2-6 1.5-5-4h-2l3 5.2-4 1-2-1.5H1.5l1 6.3z',ideas:'M9 18h6M10 21h4M12 3a6 6 0 0 0-3.5 10.9c.6.5 1 1.2 1 2.1h5c0-.9.4-1.6 1-2.1A6 6 0 0 0 12 3z'};
var NAV=[['Home','home','home'],['Tarefas','tasks','tarefas'],['Treino','train','treino'],['Wealth','wealth','wealth',1],['Agenda','cal','agenda'],['E-mails','mail','emails'],['Viagem','trip','viagem']];   // Metas e Ideias voltam quando existirem
/* Animação só quando dá para ver: aba visível, elemento exibido e dentro da tela. Fora disso, confere de novo a cada 0,5 s. */
var VISTO=new WeakMap(),IOB=window.IntersectionObserver?new IntersectionObserver(function(es){es.forEach(function(e){VISTO.set(e.target,e.isIntersecting)})}):null;
function observar(el){if(IOB&&el)IOB.observe(el)}
function visivel(el){return !document.hidden&&!!el&&el.getClientRects().length>0&&VISTO.get(el)!==false}
/* Bateria: animações a no máximo 30 quadros/s e congeladas depois de 20 s sem toque, rolagem ou tecla (voltam no próximo toque). */
var ATIVO={t:performance.now()};['pointerdown','keydown','scroll','wheel','touchstart','hashchange','focus'].forEach(function(e){addEventListener(e,function(){ATIVO.t=performance.now()},{passive:true,capture:true})});   /* correção Lente design: trocar de aba conta como uso */
function ocioso(){var o=(typeof ORB!=='undefined'?ORB:null);return performance.now()-ATIVO.t>20000&&!(o&&(o.fala||o.pensa))}
function animar(el,fn){observar(el);var ult=0;(function loop(now){if(visivel(el)&&(!ocioso()||!el.__q1)){if(now-ult>32){ult=now;fn(now);el.__q1=1}requestAnimationFrame(loop)}else setTimeout(function(){requestAnimationFrame(loop)},500)})(performance.now())}
function svg(p,w){return '<svg width="'+(w||20)+'" height="'+(w||20)+'" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="'+p+'"/></svg>'}

function renderNav(){
  var fin=D&&D.federacao.some(function(f){return f.saude==='🔴'||f.saude==='🟡'});
  var h='<div class="logo" aria-hidden="true"></div>';
  NAV.forEach(function(n){var breve=['metas','ideias'].indexOf(n[2])>=0;h+='<button class="nb glass tile" type="button" data-k="'+n[2]+'" aria-label="'+n[0]+'"'+(S.nav===n[2]?' aria-current="page"':'')+'>'+svg(ICON[n[1]])+'<span class="bar"></span><span class="nbl" aria-hidden="true">'+n[0]+'</span>'+(n[3]&&fin?'<span class="dot pulse"'+(D.federacao.some(function(f){return f.saude==='🔴'})?'':' style="background:#ffc86e;box-shadow:0 0 10px #ffc86e"')+'></span>':'')+'</button>'});
  h+='<div class="avatar" aria-label="Marcio">M</div>';
  $('nav').innerHTML=h;
  [].forEach.call($('nav').querySelectorAll('.nb'),function(b){b.onclick=function(){var k=b.dataset.k;
    if(k==='mesa'||k==='wealth'||k==='viagem'||k==='treino'||k==='tarefas'||k==='emails'||k==='agenda'){
      if(location.hash==='#'+k){window.scrollTo({top:0,behavior:'smooth'});try{var fr=$('trFrame');if(k==='treino'&&fr&&fr.contentWindow)fr.contentWindow.scrollTo({top:0,behavior:'smooth'})}catch(x){}return}   /* acabamento Lente 02: tocar na aba aberta volta ao topo */
      location.hash=k;return}
    if(location.hash){history.replaceState(null,'',location.pathname);route()}
    S.nav=k;renderNav();var tgt={tarefas:'tbody',treino:'trSub',agenda:'cal',emails:'mailp'}[k];
    if(tgt)$(tgt).scrollIntoView({behavior:'smooth',block:'center'});else if(k==='home')window.scrollTo({top:0,behavior:'smooth'});else toast(b.getAttribute('aria-label')+' entra num próximo módulo.')}});
}

function renderHero(){
  var h=new Date().getHours(), hoje=pd(D.hoje);
  $('greet').textContent=h<12?'Bom dia':h<18?'Boa tarde':'Boa noite';
  $('kick').textContent='Orbitus · '+DS[hoje.getDay()].toLowerCase()+', '+hoje.getDate()+' de '+MES[hoje.getMonth()].toLowerCase();
  var att=D.federacao.filter(function(f){return f.saude!=='🟢'}).length;
  var open=D.tarefas.filter(function(t){return !t.feito&&t.col!=='depois'}).length;
  var ocS=Object.keys(D.eventos).filter(function(k){return k>=D.hoje&&k<=D.fimSemana&&D.eventos[k].some(function(e){return e[2]==='b'})}).length;
  $('sub').textContent=(att?att+(att>1?' sistemas pedem':' sistema pede')+' atenção':'Todos os sistemas em órbita')+' · '+open+' tarefa'+(open===1?'':'s')+' nesta semana'+(D.emails&&D.emails.configurado&&!D.emails.carregando?' · '+D.emails.itens.length+' e-mails pedem resposta':'')+' · '+ocS+(ocS===1?' dia ocupado':' dias ocupados')+' até domingo';
  var top=D.tarefas.filter(function(t){return !t.feito&&t.col==='hoje'})[0];
  var esp=D.federacao.filter(function(f){return f.esperando})[0];
  var va=(D.viagem_alertas||[]).filter(function(a){return a.urgente})[0];
  if(va){$('wait').hidden=false;$('waitK').textContent='Esperando de você · viagem';$('waitT').textContent=va.texto;$('waitS').textContent=va.origem}
  else if(top){$('wait').hidden=false;$('waitK').textContent='Esperando de você · '+(top.due===D.hoje?'hoje':top.atrasada?'atrasada':'prioridade');$('waitT').textContent=top.titulo;$('waitS').textContent=top.fonte||top.tag}
  else if(esp){$('wait').hidden=false;$('waitK').textContent='Esperando de você';$('waitT').textContent=esp.esperando;$('waitS').textContent=esp.nome}
  else $('wait').hidden=true;
  var m=D.marcos[0];
  $('marks').innerHTML=D.marcos.slice(0,3).map(function(x){return '<a href="#viagem"><span class="kick" style="font-size:11.5px">'+esc(x.curto||x.nome)+' · '+x.data.slice(8)+'/'+x.data.slice(5,7)+'</span><span><b>'+x.dias+'</b> dias</span></a>'}).join('');
  var notes=[];
  D.federacao.forEach(function(f){(f.esperando_lista&&f.esperando_lista.length?f.esperando_lista:(f.esperando?[f.esperando]:[])).forEach(function(x){notes.push([x,f.nome])});(f.falhas||[]).forEach(function(x){notes.push([x,f.nome+' · saúde'])})});
  (D.viagem_alertas||[]).forEach(function(a){notes.unshift([a.texto,a.origem])});
  $('bellN').textContent=notes.length||'';
  $('notes').innerHTML=notes.map(function(n){return '<div class="note glass">'+esc(n[0])+'<small>'+esc(n[1])+'</small></div>'}).join('')||'<div class="note glass">Nada pendente.</div>';
  $('legend').innerHTML='';
  var wealth=D.federacao.filter(function(f){return f.id==='wealth'})[0];
  var ev=Object.keys(D.eventos).filter(function(k){return k>=D.hoje}).length;
  Orb.nodes([]);   // anel limpo: é o rosto do Concierge; os números ficam nos cards
}

function dueL(t){if(!t.due)return 'sem data';if(t.due===D.hoje)return 'Hoje';if(t.atrasada)return 'atrasada';return t.due.slice(8)+'/'+t.due.slice(5,7)}
/* ===================== TAREFAS: criar, acompanhar, editar, remover, sugestões ===================== */
var TT=null,AREAS_T=['Pessoal','Trabalho','Finanças','Saúde','Viagem'],AREA_COR={'Pessoal':'#9feee6','Trabalho':'#c6d0ff','Finanças':'#ffb3c8','Saúde':'#ffd27a','Viagem':'#b8f0c8'};
var REP_T=[['','Não repete'],['every day','Todo dia'],['every weekday','Dias úteis'],['every week','Toda semana'],['every month','Todo mês'],['every year','Todo ano']];
var PRIO_T=[['3','Normal'],['0','Urgente'],['1','Alta'],['2','Média'],['4','Baixa']],ST_T={'':'A fazer','fazendo':'Fazendo','aguardando':'Aguardando'};
function fdT(k){if(!k)return '';var d=pd(k);var hj=pd(D.hoje),df=Math.round((d-hj)/864e5);return df===0?'Hoje':df===1?'Amanhã':df===-1?'Ontem':DS[d.getDay()].slice(0,3).toLowerCase()+' '+k.slice(8)+'/'+k.slice(5,7)}
function repL(r){if(!r)return '';var b=r.replace(/ on \w+$/,''),x=REP_T.filter(function(o){return o[0]===b})[0];return (x?x[1]:r)+(/ on (\w+)/.test(r)?' ('+({Monday:'seg',Tuesday:'ter',Wednesday:'qua',Thursday:'qui',Friday:'sex',Saturday:'sáb',Sunday:'dom'}[r.match(/ on (\w+)/)[1]]||'')+')':'')}
function opts(lista,v){return lista.map(function(o){var k=Array.isArray(o)?o[0]:o,l=Array.isArray(o)?o[1]:o;return '<option value="'+esc(k)+'"'+(String(v)===String(k)?' selected':'')+'>'+esc(l)+'</option>'}).join('')}
function loadTT(){return fetch('/api/tarefas',{cache:'no-store'}).then(function(r){return r.json()}).then(function(j){if(j.erro)throw new Error(j.erro);TT=j;renderTasks()}).catch(function(e){TT={erro:e.message,feitas:[],arquivo:[],sugestoes:[],placar:{}};renderTasks()})}
function taskRow(t,i){
  var meta=[];if(t.fonte)meta.push(esc(t.fonte));if(t.repete)meta.push('↻ '+repL(t.repete));if(t.url)meta.push('<a href="'+esc(t.url)+'" target="_blank" rel="noopener" class="lk">abrir link</a>');
  var dl=t.due?fdT(t.due)+(t.hora?' '+t.hora:''):'sem data',hot=t.due&&t.due<=D.hoje;
  return '<li class="task glass'+(t.status?' st-'+t.status:'')+'" data-i="'+i+'"><button class="chk" type="button" data-t="'+i+'" aria-pressed="false" aria-label="Concluir: '+esc(t.titulo)+'"></button>'+
    '<div style="flex-grow:1;min-width:0"><div class="tt">'+(t.prio===0?'<span class="pr0" title="Urgente">!</span> ':t.prio===1?'<span class="pr1" title="Alta">↑</span> ':'')+esc(t.titulo)+'</div>'+(meta.length?'<div class="ts">'+meta.join(' · ')+'</div>':'')+'</div>'+
    '<button type="button" class="stb" data-st="'+i+'" title="Mudar a situação">'+ST_T[t.status||'']+'</button>'+
    '<span class="tag" style="color:'+(AREA_COR[t.tag]||'#9feee6')+';background:rgba(255,255,255,.05)">'+esc(t.tag)+'</span><span class="due'+(hot?' hot':'')+'">'+(t.atrasada?'atrasada':dl)+'</span>'+
    '<button type="button" class="ib" data-ed="'+i+'" aria-label="Editar: '+esc(t.titulo)+'">'+svg('M4 20h4L19 9l-4-4L4 16zM14 6l4 4',15)+'</button>'+
    '<button type="button" class="ib" data-rm="'+i+'" aria-label="Remover: '+esc(t.titulo)+'">'+svg('M5 7h14M10 11v6M14 11v6M6 7l1 13h10l1-13M9 7V4h6v3',15)+'</button></li>'}
function editRow(t,i){
  return '<li class="task glass tedit" data-i="'+i+'"><form class="tef" data-ef="'+i+'"><input name="titulo" value="'+esc(t.titulo)+'" aria-label="Título"><input name="fonte" value="'+esc(t.fonte||'')+'" placeholder="Contexto (opcional)" aria-label="Contexto">'+
    '<div class="tnf"><input type="date" name="due" value="'+esc(t.due||'')+'" aria-label="Data"><input type="time" name="hora" value="'+esc(t.hora||'')+'" aria-label="Hora">'+
    '<select name="area" aria-label="Área">'+opts(AREAS_T,t.tag)+'</select><select name="prio" aria-label="Prioridade">'+opts(PRIO_T,t.prio)+'</select>'+
    '<select name="repete" aria-label="Repetição">'+opts(REP_T.concat(t.repete&&!REP_T.some(function(o){return o[0]===t.repete})?[[t.repete,repL(t.repete)]]:[]),t.repete||'')+'</select>'+
    '<select name="status" aria-label="Situação">'+opts([['','A fazer'],['fazendo','Fazendo'],['aguardando','Aguardando']],t.status||'')+'</select>'+
    '<button class="btn" type="submit">Salvar</button><button class="btn g" type="button" data-cx="1">Cancelar</button></div></form></li>'}
function renderTasks(){
  if(!D)return;
  if(!TT&&document.body.classList.contains('tarefas')){loadTT()}
  var tt=S.ttab||'abertas',P=(TT&&TT.placar)||{},sug=(TT&&TT.sugestoes)||[];
  var open=D.tarefas.map(function(t,i){t._i=i;return t}).filter(function(t){return !t.feito});
  $('tcount').textContent=open.length+' abertas · '+open.filter(function(t){return t.atrasada}).length+' atrasadas'+(P.feitas_semana!=null?' · '+P.feitas_semana+' feitas na semana':'')+(P.fazendo?' · '+P.fazendo+' fazendo':'')+(P.aguardando?' · '+P.aguardando+' aguardando':'');
  var cont={};open.forEach(function(t){cont[t.tag]=(cont[t.tag]||0)+1});
  if(S.filter!=='all'&&AREAS_T.indexOf(S.filter)<0)S.filter='all';
  $('filters').innerHTML=[['all','Todas']].concat(AREAS_T.filter(function(a){return cont[a]}).map(function(a){return [a,a+' '+cont[a]]})).map(function(f){return '<button type="button" data-f="'+f[0]+'" aria-pressed="'+(S.filter===f[0])+'">'+esc(f[1])+'</button>'}).join('');
  $('views').innerHTML=[['list','Lista','M8 6h12M8 12h12M8 18h12M4 6h.01M4 12h.01M4 18h.01'],['board','Quadro','M4 4h5v16H4zM10.5 4h5v10h-5zM17 4h3v7h-3z']].map(function(v){return '<button type="button" data-v="'+v[0]+'" aria-pressed="'+(S.view===v[0])+'">'+svg(v[2],15)+v[1]+'</button>'}).join('');
  $('tTabs').innerHTML=[['abertas','Abertas',open.length],['sugeridas','Sugeridas',sug.length],['feitas','Concluídas',(TT&&TT.feitas||[]).length],['arquivo','Arquivo',(TT&&TT.arquivo||[]).length]].map(function(x){return '<button type="button" role="tab" data-tt="'+x[0]+'" aria-selected="'+(tt===x[0])+'" aria-pressed="'+(tt===x[0])+'">'+x[1]+(x[2]?' <span class="'+(x[0]==='sugeridas'?'nsug':'n')+'">'+x[2]+'</span>':'')+'</button>'}).join('');
  $('filters').style.display=$('views').style.display=tt==='abertas'?'':'none';
  var h='';
  if(tt==='abertas'){
    var L=open.filter(function(t){return S.filter==='all'||t.tag===S.filter});
    L.sort(function(a,b){return (a.atrasada?0:1)-(b.atrasada?0:1)||(a.due||'9999').localeCompare(b.due||'9999')||(a.hora||'99').localeCompare(b.hora||'99')||a.prio-b.prio});
    if(S.view==='list'){h='<ul class="tasks">'+L.map(function(t){return S.edit===t._i?editRow(t,t._i):taskRow(t,t._i)}).join('')+'</ul>'+(L.length?'':'<div class="empty">Nada aqui. Crie uma tarefa acima.</div>')}
    else{var cols=[['hoje','Hoje e atrasadas','#ff5d8c'],['semana','Próximos 7 dias','#7fe9df'],['depois','Depois ou sem data','#6c8cff']];
      var lim7=key(new Date(pd(D.hoje).getTime()+7*864e5));
      var colB=function(t){return (t.atrasada||t.prio===0||(t.due&&t.due<=D.hoje))?'hoje':(t.due&&t.due<=lim7)?'semana':'depois'};
      h='<div class="board"><div>'+cols.map(function(c){var it=L.filter(function(t){return colB(t)===c[0]});return '<div class="col"><div class="colh"><span><i style="background:'+c[2]+';box-shadow:0 0 8px '+c[2]+'"></i>'+c[1]+'</span><span style="color:var(--mut);font-size:13px">'+it.length+'</span></div><ul class="tasks bcol">'+it.map(function(t){return S.edit===t._i?editRow(t,t._i):taskRow(t,t._i)}).join('')+'</ul>'+(it.length?'':'<div class="empty">Vazio.</div>')+'</div>'}).join('')+'</div></div>'}
  }else if(tt==='sugeridas'){
    h=TT?(sug.length?'<p class="tsug-int">O que os agentes e sistemas pedem de você e ainda não virou tarefa. Nada entra sozinho: aceite ou dispense.</p><ul class="tasks">'+sug.map(function(s,i){return '<li class="task glass sug"><span class="org">'+esc(s.origem)+'</span><div style="flex-grow:1;min-width:0"><div class="tt">'+esc(s.titulo)+'</div><div class="ts">'+[s.fonte&&s.fonte!==s.origem?esc(s.fonte):'',s.motivo?esc(s.motivo):'',s.due?'para '+fdT(s.due):''].filter(Boolean).join(' · ')+'</div></div><span class="tag" style="color:'+(AREA_COR[s.area]||'#9feee6')+';background:rgba(255,255,255,.05)">'+esc(s.area)+'</span><button class="btn" type="button" data-ac="'+i+'" style="height:34px;font-size:13px">Aceitar</button><button class="btn g" type="button" data-dp="'+i+'" style="height:34px;font-size:13px">Dispensar</button></li>'}).join('')+'</ul>':'<div class="empty">Nenhuma sugestão agora. Elas vêm das Mesas, dos e-mails que pedem resposta, das viagens e da saúde das rotinas.</div>'):'<div class="empty">Carregando…</div>';
  }else if(tt==='feitas'){
    var F=(TT&&TT.feitas)||[],g={};F.forEach(function(t){(g[t.feita_em]=g[t.feita_em]||[]).push(t)});
    h=Object.keys(g).length?Object.keys(g).sort().reverse().map(function(k){return '<div class="kick" style="margin:18px 0 8px">'+fdT(k)+' · '+g[k].length+'</div><ul class="tasks" style="margin:0">'+g[k].map(function(t){return '<li class="task glass done"><button class="chk" type="button" data-un="'+F.indexOf(t)+'" aria-pressed="true" aria-label="Reabrir: '+esc(t.titulo)+'"><svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12l5 5 9-10"/></svg></button><div style="flex-grow:1;min-width:0"><div class="tt">'+esc(t.titulo)+'</div>'+(t.fonte?'<div class="ts">'+esc(t.fonte)+'</div>':'')+'</div><span class="tag" style="color:'+(AREA_COR[t.area]||'#9feee6')+';background:rgba(255,255,255,.05)">'+esc(t.area)+'</span></li>'}).join('')+'</ul>'}).join(''):'<div class="empty">'+(TT?'Nada concluído nos últimos 30 dias.':'Carregando…')+'</div>';
  }else{
    var A=(TT&&TT.arquivo)||[];
    h=A.length?'<p class="tsug-int">Tarefas removidas ficam aqui (no fim do Tarefas.md, como canceladas). Restaurar devolve para a Inbox.</p><ul class="tasks">'+A.map(function(t,i){return '<li class="task glass" style="opacity:.8"><div style="flex-grow:1;min-width:0"><div class="tt" style="text-decoration:line-through;text-decoration-color:rgba(255,255,255,.3)">'+esc(t.titulo)+'</div><div class="ts">removida '+fdT(t.removida_em)+(t.fonte?' · '+esc(t.fonte):'')+'</div></div><button class="btn g" type="button" data-rs="'+i+'" style="height:34px;font-size:13px">Restaurar</button></li>'}).join('')+'</ul>':'<div class="empty">'+(TT?'Arquivo vazio.':'Carregando…')+'</div>';
  }
  if(TT&&TT.erro)h='<div class="empty">Não consegui ler o histórico: '+esc(TT.erro)+'. Reinicie o app.</div>'+h;
  $('tbody').innerHTML=h;
  var B=$('tbody');
  [].forEach.call($('filters').children,function(b){b.onclick=function(){S.filter=b.dataset.f;save();renderTasks()}});
  [].forEach.call($('views').children,function(b){b.onclick=function(){S.view=b.dataset.v;save();renderTasks()}});
  [].forEach.call($('tTabs').children,function(b){b.onclick=function(){S.ttab=b.dataset.tt;S.edit=null;renderTasks()}});
  [].forEach.call(B.querySelectorAll('[data-t]'),function(b){b.onclick=function(){toggle(D.tarefas[+b.dataset.t])}});
