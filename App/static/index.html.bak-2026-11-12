<link href="https://fonts.googleapis.com/css2?family=Manrope:wght@200;300;400;500;600&display=swap" rel="stylesheet">
<style>
:root{--bg:#04060b;--txt:#eef2f8;--mut:#aab2c4;--mut2:#c4cad7;--cy:#7fe9df;--pk:#ff5d8c;--pk2:#ff8fb0;--bl:#6c8cff}
*{box-sizing:border-box}
html,body{margin:0;background:var(--bg);color:var(--txt);font-family:Manrope,system-ui,sans-serif;font-weight:300}
button{font-family:inherit}
.glass{background:linear-gradient(160deg,rgba(255,255,255,.11),rgba(255,255,255,.03));border:1px solid rgba(255,255,255,.12);backdrop-filter:blur(28px) saturate(140%);-webkit-backdrop-filter:blur(28px) saturate(140%);box-shadow:inset 0 1px 0 rgba(255,255,255,.14),0 24px 60px -30px rgba(0,0,0,.9)}
.tile{transition:background .3s,transform .25s,color .25s;cursor:pointer}
.tile:hover{transform:translateY(-2px);color:#fff}
.kick{font-size:12px;font-weight:400;letter-spacing:.2em;text-transform:uppercase;color:var(--mut)}
.card{animation:rise .8s cubic-bezier(.2,.8,.2,1) both}
.pulse{animation:pulse 1.6s ease-out infinite}
@keyframes rise{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:none}}
@keyframes pulse{0%{box-shadow:0 0 0 0 rgba(255,93,140,.6)}100%{box-shadow:0 0 0 10px rgba(255,93,140,0)}}
@media (prefers-reduced-motion:reduce){.card,.pulse{animation:none}}

.page{min-height:100vh;background:radial-gradient(1200px 700px at 58% 18%,#0b1424 0%,#04060b 60%);padding:20px;display:flex;flex-wrap:wrap;gap:20px;align-items:flex-start}
nav{flex:0 0 64px;display:flex;flex-direction:column;align-items:center;gap:10px;padding-top:6px}
.logo{width:52px;height:52px;border-radius:16px;margin-bottom:14px;background:radial-gradient(circle at 50% 50%,#fff 0 3px,rgba(127,233,223,.25) 4px 9px,transparent 10px),conic-gradient(from 90deg,rgba(127,233,223,.55),rgba(255,93,140,.45),rgba(108,140,255,.55),rgba(127,233,223,.55));box-shadow:0 0 24px rgba(127,233,223,.35)}
.nb{width:56px;height:56px;border-radius:16px;color:#a9b1c3;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:7px;padding:0;position:relative}
.nb .bar{width:16px;height:2px;border-radius:2px;background:transparent}
.nb[aria-current=page]{height:72px;color:#fff;background:linear-gradient(160deg,rgba(255,255,255,.24),rgba(255,255,255,.08))}
.nb[aria-current=page] .bar{background:var(--cy)}
.nb .dot{position:absolute;top:9px;right:9px;width:6px;height:6px;border-radius:50%;background:var(--pk)}
.avatar{margin-top:30px;width:48px;height:48px;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:17px;font-weight:400;color:#04060b;background:linear-gradient(135deg,var(--cy),var(--bl))}
main{flex:999 1 560px;min-width:0;display:flex;flex-direction:column;gap:20px}

.hero{position:relative;height:680px;border-radius:32px;overflow:hidden;border:1px solid rgba(255,255,255,.08);background:#03050a}
.hero canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
.htop{position:absolute;top:34px;left:38px;right:34px;display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px;align-items:flex-start}
h1{margin:14px 0 8px;font-size:64px;font-weight:200;line-height:1;letter-spacing:-.035em;color:#fff}
h1 span{color:var(--mut)}
.sub{margin:0;font-size:16px;color:var(--mut2)}
.search{display:flex;align-items:center;gap:10px;border-radius:16px;padding:0 16px;height:56px;min-width:280px}
.search input{background:transparent;border:none;outline:none;color:var(--txt);font:300 14px Manrope,sans-serif;flex-grow:1;min-width:0}
.search kbd{font:400 11px Manrope;color:var(--mut);border:1px solid rgba(255,255,255,.16);border-radius:6px;padding:2px 6px}
.bell{width:56px;height:56px;border-radius:16px;color:#e3e8f1;display:flex;align-items:center;justify-content:center;padding:0;position:relative}
.bell b{position:absolute;top:7px;right:10px;font-size:12px;font-weight:400;color:var(--pk2)}
.notes{position:absolute;top:100px;right:34px;width:300px;display:none;flex-direction:column;gap:8px;z-index:3}
.notes.open{display:flex}
.note{border-radius:16px;padding:12px 14px;font-size:13px;line-height:1.4}
.note small{display:block;color:var(--mut);margin-top:3px;font-size:12px}
.hbot{position:absolute;left:28px;right:28px;bottom:28px;display:flex;flex-wrap:wrap;gap:14px;justify-content:space-between;align-items:flex-end}
.wait{border-radius:22px;padding:18px 20px;max-width:440px;display:flex;gap:14px;align-items:flex-start}
.itile{width:46px;height:46px;flex:none;border-radius:14px;display:flex;align-items:center;justify-content:center}
.wait .kick{color:var(--pk2);display:flex;align-items:center;gap:8px}
.wait .kick i{width:6px;height:6px;border-radius:50%;background:var(--pk)}
.wait .t{margin-top:8px;font-size:19px;line-height:1.3;color:#fff}
.wait .s{margin-top:5px;font-size:13px;color:#a9b1c3}
.legend{display:flex;flex-wrap:wrap;gap:8px}
.legend span{display:inline-flex;align-items:center;gap:8px;border-radius:12px;padding:9px 13px;font-size:12px;font-weight:400;color:#d3d9e5}
.legend i{width:7px;height:7px;border-radius:50%}
.mark{border-radius:22px;padding:18px 20px;min-width:220px}
.big{font-size:44px;font-weight:200;line-height:1;letter-spacing:-.03em;color:#fff}
.big small{font-size:16px;font-weight:300;color:#a9b1c3}

.grid{display:flex;flex-wrap:wrap;gap:20px;align-items:stretch}
.panel{border-radius:28px;padding:24px;min-width:0}
.ph{display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;gap:14px}
.ph .l{display:flex;align-items:center;gap:14px}
.ptile{width:52px;height:52px;flex:none;border-radius:15px;display:flex;align-items:center;justify-content:center}
h2{margin:0;font-size:26px;font-weight:300;letter-spacing:-.02em}
.ps{font-size:13px;color:var(--mut);margin-top:2px}
.seg{display:flex;gap:4px;padding:4px;border-radius:14px}
.seg button{height:36px;padding:0 13px;border-radius:10px;border:none;cursor:pointer;font:400 13px Manrope;background:transparent;color:#a9b1c3;display:flex;align-items:center;gap:6px}
.seg button[aria-pressed=true]{background:rgba(255,255,255,.16);color:#fff}
ul.tasks{list-style:none;margin:20px 0 0;padding:0;display:flex;flex-direction:column;gap:8px}
.task{display:flex;align-items:center;gap:14px;padding:13px 14px;border-radius:16px}
.task.done{opacity:.45}
.task.done .tt{text-decoration:line-through}
.chk{width:24px;height:24px;flex:none;border-radius:8px;cursor:pointer;border:1.2px solid rgba(255,255,255,.35);background:transparent;display:flex;align-items:center;justify-content:center;padding:0;color:#04060b}
.done .chk{background:var(--cy);border-color:var(--cy)}
.tt{font-size:15px;font-weight:400}
.ts{margin-top:3px;font-size:12px;color:var(--mut)}
.tag{flex:none;font-size:12px;font-weight:400;letter-spacing:.08em;text-transform:uppercase;padding:6px 10px;border-radius:10px}
.tag.f{color:#ffb3c8;background:rgba(255,93,140,.12)}
.tag.p{color:#9feee6;background:rgba(127,233,223,.10)}
.due{flex:none;width:72px;text-align:right;font-size:13px;color:var(--mut)}
.due.hot{color:var(--pk2);font-weight:500}
.board{margin-top:20px;overflow-x:auto}
.board>div{display:grid;grid-template-columns:repeat(3,minmax(210px,1fr));gap:12px}
.col{border-radius:20px;padding:12px;background:rgba(255,255,255,.02);border:1px solid rgba(255,255,255,.06);display:flex;flex-direction:column;gap:10px}
.colh{display:flex;justify-content:space-between;align-items:center;padding:4px 6px;font-size:15px}
.colh span{display:flex;align-items:center;gap:8px}
.colh i{width:7px;height:7px;border-radius:50%}
.kc{border-radius:16px;padding:14px;transition:transform .25s}
.kc:hover{transform:translateY(-2px)}
.kc .row{margin-top:12px;display:flex;justify-content:space-between;align-items:center;gap:8px}
.empty{font-size:13px;color:var(--mut);padding:8px 6px}

.ring{position:relative;width:112px;height:112px;flex:none}
.ring div{position:absolute;inset:0;display:flex;flex-direction:column;align-items:center;justify-content:center}
.wk{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
.wk div{display:flex;flex-direction:column;align-items:center;gap:6px;font-size:12px;color:var(--mut)}
.wk span{width:34px;height:34px;border-radius:11px}
.wk .on{color:var(--cy)}
.wk .on span{border-color:rgba(127,233,223,.6)}
.chips{display:flex;flex-wrap:wrap;gap:6px}
.chips span{font-size:12px;font-weight:400;color:#d3d9e5;padding:6px 10px;border-radius:10px}
.cta{margin-top:auto;display:flex;align-items:center;justify-content:center;height:48px;border-radius:14px;text-decoration:none;font-size:14px;font-weight:500;color:#04060b;background:linear-gradient(135deg,var(--cy),var(--bl))}

.cal{margin-top:18px;display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:6px}
.wd{text-align:center;font-size:12px;font-weight:400;letter-spacing:.14em;text-transform:uppercase;color:var(--mut);padding:6px 0}
.day{height:60px;border-radius:15px;cursor:pointer;padding:9px;display:flex;flex-direction:column;justify-content:space-between;align-items:flex-start;font:300 15px Manrope;color:#a9b1c3;background:linear-gradient(160deg,rgba(255,255,255,.06),rgba(255,255,255,.015));border:1px solid rgba(255,255,255,.08);box-shadow:inset 0 1px 0 rgba(255,255,255,.06)}
.day.busy{color:#fff;font-weight:500;background:linear-gradient(160deg,rgba(255,93,140,.14),rgba(255,93,140,.04))}
.day.sel{background:rgba(255,255,255,.14);border-color:rgba(127,233,223,.5)}
.day.today{color:#04060b;font-weight:500;background:linear-gradient(160deg,#a5f3eb,#7fe9df)}
.day.pad{visibility:hidden}
.dots{display:flex;gap:4px}
.dots .b{width:6px;height:6px;border-radius:50%;background:var(--pk);box-shadow:0 0 8px var(--pk)}
.dots .r{width:6px;height:6px;border-radius:50%;border:1.2px solid var(--cy)}
.today .dots .b{background:#04060b;box-shadow:none}
.today .dots .r{border-color:#04060b}
.navb{width:44px;height:44px;border-radius:13px;color:#e3e8f1;display:flex;align-items:center;justify-content:center;padding:0}
.ev{display:flex;gap:12px;padding:13px;border-radius:16px}
.ev i{width:2px;border-radius:2px;flex:none}
.ev small{font-size:12px;font-weight:400;color:var(--mut)}
.ev div div{margin-top:4px;font-size:14px;font-weight:400;line-height:1.4}
.mail{display:flex;align-items:center;gap:14px;padding:13px 14px;border-radius:16px;text-decoration:none;color:var(--txt);transition:transform .2s}
.mail:hover{transform:translateX(3px)}
.acc{flex:none;width:40px;height:40px;border-radius:12px;display:flex;align-items:center;justify-content:center;font-size:12px;font-weight:500}
.mail .who{font-size:15px;font-weight:400;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mail .sub{margin-top:3px;font-size:13px;color:#d3d9e5;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.mail .pv{margin-top:4px;font-size:12px;line-height:1.5;color:var(--mut);display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
.mail.lido .who{font-weight:300;color:var(--mut2)}
.mail .ud{width:7px;height:7px;border-radius:50%;background:var(--cy);flex:none;box-shadow:0 0 8px var(--cy)}
.mail .age{flex:none;font-size:12px;color:var(--mut)}
.accs{display:flex;flex-wrap:wrap;gap:8px}
.accs span{font-size:12px;font-weight:400;padding:8px 12px;border-radius:12px;color:#d3d9e5}
.grid>section{order:5}#decp{order:0!important}.grid>section:nth-of-type(1),.grid>section:nth-of-type(2){order:1}#mailp{order:2}
.dec{border-radius:20px;padding:20px}
.dec .top{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;align-items:flex-start}
.dec h3{margin:0;font-size:20px;font-weight:300;letter-spacing:-.01em}
.dec .q{margin-top:6px;font-size:15px;color:#d3d9e5;font-weight:400}
.dec .ctx{margin-top:10px;font-size:13px;line-height:1.55;color:var(--mut2)}
.chip{font-size:12px;font-weight:400;letter-spacing:.08em;text-transform:uppercase;padding:6px 10px;border-radius:10px;white-space:nowrap}
.chip.alta{color:#ffb3c8;background:rgba(255,93,140,.12)}.chip.media{color:#ffe1a6;background:rgba(255,200,87,.10)}.chip.baixa{color:#9feee6;background:rgba(127,233,223,.10)}
.chip.ok{color:#9feee6;background:rgba(127,233,223,.10)}.chip.wait{color:#c6d0ff;background:rgba(108,140,255,.14)}.chip.mut{color:var(--mut);background:rgba(255,255,255,.05)}
.opts{display:grid;grid-template-columns:repeat(auto-fill,minmax(220px,1fr));gap:8px;margin-top:14px}
.opt{text-align:left;padding:14px;border-radius:14px;cursor:pointer;color:var(--txt);font:300 14px/1.45 Manrope;display:flex;gap:12px;align-items:flex-start;transition:border-color .2s,background .2s}
.opt b{flex:none;width:26px;height:26px;border-radius:8px;display:flex;align-items:center;justify-content:center;font-weight:500;background:rgba(255,255,255,.08)}
.opt[aria-pressed=true]{border-color:rgba(127,233,223,.6);background:linear-gradient(160deg,rgba(127,233,223,.18),rgba(127,233,223,.04))}
.opt[aria-pressed=true] b{background:var(--cy);color:#04060b}
.dflt{margin-top:10px;font-size:12px;color:var(--mut)}
.nota{width:100%;margin-top:12px;min-height:44px;resize:vertical;border-radius:12px;padding:10px 12px;color:var(--txt);font:300 14px Manrope;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);outline:none}
.nota:focus{border-color:rgba(127,233,223,.5)}
.btn{height:42px;padding:0 18px;border-radius:12px;border:none;cursor:pointer;font:500 14px Manrope;color:#04060b;background:linear-gradient(135deg,var(--cy),var(--bl))}
.btn.g{color:var(--txt);background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);font-weight:400}
.btn.d{color:#ffb3c8;background:rgba(255,93,140,.1);border:1px solid rgba(255,93,140,.3);font-weight:400}
.btn[disabled]{opacity:.4;cursor:default}
.acts{display:flex;flex-wrap:wrap;gap:8px;margin-top:12px;align-items:center}
.sent{margin-top:14px;padding:12px 14px;border-radius:12px;font-size:14px;background:rgba(108,140,255,.1);border:1px solid rgba(108,140,255,.25)}
.hist{display:flex;flex-direction:column;gap:6px;margin-top:10px}
.hrow{display:flex;gap:12px;align-items:center;padding:10px 12px;border-radius:12px;background:rgba(255,255,255,.025);border:1px solid rgba(255,255,255,.05);font-size:13px}
.hrow .t{flex-grow:1;min-width:0;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.hrow small{color:var(--mut);flex:none}
details summary{cursor:pointer;color:var(--mut);font-size:13px;margin-top:16px;list-style:none}
details summary::-webkit-details-marker{display:none}
.fields{display:grid;grid-template-columns:repeat(auto-fill,minmax(150px,1fr));gap:8px;margin-top:12px}
.fields label{display:flex;flex-direction:column;gap:4px;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--mut)}
.fields input{height:40px;border-radius:10px;padding:0 10px;color:var(--txt);font:300 14px Manrope;background:rgba(255,255,255,.04);border:1px solid rgba(255,255,255,.1);outline:none;text-transform:none;letter-spacing:0}
.tl{display:flex;flex-direction:column;gap:0;margin-top:14px;position:relative}
.step{display:grid;grid-template-columns:110px 18px 1fr auto;gap:14px;align-items:start;padding:12px 0}
.step .dt{font-size:12px;color:var(--mut);text-align:right;padding-top:2px}
.step .nd{width:12px;height:12px;border-radius:50%;margin-top:4px;border:1.5px solid rgba(255,255,255,.3);position:relative}
.step .nd::after{content:"";position:absolute;left:4px;top:14px;width:1px;height:46px;background:rgba(255,255,255,.08)}
.step:last-child .nd::after{display:none}
.step.feito .nd{background:var(--cy);border-color:var(--cy)}
.step.agora .nd{border-color:var(--pk);box-shadow:0 0 0 4px rgba(255,93,140,.15)}
.step .ac{font-size:15px;font-weight:400}
.step .ob{font-size:12px;color:var(--mut);margin-top:3px;line-height:1.45}
.prog{height:4px;border-radius:4px;background:rgba(255,255,255,.08);overflow:hidden;margin-top:10px}
.prog i{display:block;height:100%;background:linear-gradient(90deg,var(--cy),var(--bl));border-radius:4px}
.upd{border-radius:16px;padding:16px;display:flex;flex-direction:column;gap:6px}
.upd .h{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}
.upd .n{font-size:12px;color:var(--mut)}
.upd .tt{font-size:16px}
.upd p{margin:0;font-size:13px;line-height:1.5;color:var(--mut2)}
.upd .you{font-size:13px;color:#ffe1a6}
/* Mesa hero */
.mhero{position:relative;border-radius:32px;border:1px solid rgba(255,255,255,.08);background:radial-gradient(900px 500px at 50% 45%,#0a1018 0%,#030509 70%);padding:32px 36px 28px;display:flex;flex-direction:column;gap:22px}
.mtop{display:flex;flex-wrap:wrap;justify-content:space-between;gap:16px}
.tier{display:flex;flex-direction:column;gap:10px;align-items:center}
.tl2{font-size:12px;letter-spacing:.24em;text-transform:uppercase;color:var(--mut)}
.row{display:flex;flex-wrap:wrap;justify-content:center;gap:6px 10px}
.row.esp{display:grid;grid-template-columns:repeat(6,minmax(0,1fr));width:100%}
.agc{display:flex;flex-direction:column;align-items:center;gap:2px;background:none;border:1px solid transparent;border-radius:20px;padding:6px 8px 10px;cursor:pointer;color:var(--txt);font-family:inherit;transition:background .25s,border-color .25s}
.agc:hover,.agc:focus-visible{background:rgba(255,255,255,.04);border-color:rgba(255,255,255,.1);outline:none}
.agc.on{background:linear-gradient(160deg,rgba(255,255,255,.09),rgba(255,255,255,.02));border-color:rgba(255,255,255,.16)}
.agc canvas{width:112px;height:112px;display:block}
.agc.big canvas{width:210px;height:210px}
.agc.ad canvas{width:140px;height:140px}
.agc .nm{font-size:14px;font-weight:400;margin-top:2px;white-space:nowrap}
.agc.big .nm{font-size:18px}
.agc .tt2{font-size:12px;letter-spacing:.06em;color:var(--mut);white-space:nowrap}
.agc .vt2{font-size:12px;margin-top:4px;padding:2px 7px;border-radius:7px;border:1px solid rgba(255,255,255,.14);color:#d3d9e5}
.tier.mid .row{align-items:center;gap:40px}
.mgrid{display:flex;flex-wrap:wrap;gap:24px;align-items:flex-start}
.mleft{flex:3 1 640px;min-width:0;display:flex;flex-direction:column;gap:22px}
.mside{flex:1 1 320px;min-width:0;max-width:440px;display:flex;flex-direction:column;gap:14px}
.sdec{border-radius:22px;padding:18px 20px}
.sdec .dec{padding:16px;border-radius:16px}
.sdec .dec h3{font-size:17px}
