/* ---------- raio-x desenhado ---------- */
function desenharRx(foco, ok) {
  const g = rxCanvas.getContext('2d'), W = rxCanvas.width, H = rxCanvas.height;
  g.clearRect(0, 0, W, H);
  const fundo = g.createLinearGradient(0, 0, 0, H); fundo.addColorStop(0, 'rgba(40,90,140,.55)'); fundo.addColorStop(1, 'rgba(20,50,95,.5)');
  g.fillStyle = fundo; g.fillRect(0, 0, W, H);
  g.strokeStyle = 'rgba(150,220,255,.14)'; g.lineWidth = 1;
  for (let y = 0; y < H; y += 18) { g.beginPath(); g.moveTo(0, y); g.lineTo(W, y); g.stroke(); }
  const cx = W / 2, osso = 'rgba(210,240,255,.92)', real = 'rgba(255,150,80,.95)';
  const parte = (nome) => (foco && foco.indexOf(nome) >= 0) ? (ok ? 'rgba(90,240,160,.95)' : real) : osso;
  g.lineCap = 'round'; g.shadowColor = 'rgba(140,220,255,.9)'; g.shadowBlur = 8;
  g.strokeStyle = osso; g.lineWidth = 4; g.beginPath(); g.arc(cx, 46, 24, 0, 6.283); g.stroke();
  g.lineWidth = 5; g.beginPath(); g.moveTo(cx, 72); g.lineTo(cx, 200); g.stroke();
  g.strokeStyle = parte('peito'); g.lineWidth = 3;
  for (let i = 0; i < 6; i++) { const y = 96 + i * 14; g.beginPath(); g.ellipse(cx, y, 40 - i * 2, 7, 0, 0, 6.283); g.stroke(); }
  g.strokeStyle = parte('ombro'); g.lineWidth = 5; g.beginPath(); g.moveTo(cx - 50, 86); g.lineTo(cx + 50, 86); g.stroke();
  g.strokeStyle = parte('braco');
  for (const s of [-1, 1]) { g.beginPath(); g.moveTo(cx + 50 * s, 86); g.lineTo(cx + 64 * s, 150); g.lineTo(cx + 70 * s, 212); g.stroke(); }
  g.strokeStyle = parte('quadril'); g.lineWidth = 5; g.beginPath(); g.ellipse(cx, 212, 36, 14, 0, 0, 6.283); g.stroke();
  g.strokeStyle = parte('perna'); g.lineWidth = 6;
  for (const s of [-1, 1]) { g.beginPath(); g.moveTo(cx + 22 * s, 222); g.lineTo(cx + 26 * s, 284); g.lineTo(cx + 24 * s, 344); g.stroke(); }
  rxTex.needsUpdate = true;
}
function focoDaSessao(nome) {
  const n = (nome || '').toLowerCase();
  if (/perna|inferior|gl[uú]te|quadr/.test(n)) return ['perna', 'quadril'];
  if (/peito|empurr|push/.test(n)) return ['peito', 'ombro', 'braco'];
  if (/costa|puxa|pull/.test(n)) return ['ombro', 'braco'];
