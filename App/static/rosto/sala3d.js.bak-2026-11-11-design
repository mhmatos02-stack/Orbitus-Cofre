const rb = (w, h, d, r = .04) => new RoundedBoxGeometry(w, h, d, 3, r);
function malha(geo, mat, x = 0, y = 0, z = 0, sombra = true) {
  const m = new THREE.Mesh(geo, mat);
  m.position.set(x, y, z);
  m.castShadow = sombra; m.receiveShadow = true;
  return m;
}
const tecido = (cor) => new THREE.MeshStandardMaterial({ color: cor, roughness: .95 });
const luz = (cor, int = 2) => new THREE.MeshStandardMaterial({ color: cor, emissive: cor, emissiveIntensity: int, roughness: .4 });

