/* ---------- boneco ---------- */
function boneco(o) {
  const raiz = new THREE.Group(), corpo = new THREE.Group();
  raiz.add(corpo);
  const roupa = tecido(o.cor), barra = tecido(o.barra || 0xc8ad8c), olhoM = luz(o.olho, 2.2);
  // pernas e tênis
  const pernas = [];
  for (const s of [-1, 1]) {
    const p = new THREE.Group(); p.position.set(.12 * s, .34, 0);
    p.add(malha(new THREE.CapsuleGeometry(.085, .16, 6, 12), M.branco, 0, -.13, 0));
    p.add(malha(rb(.19, .1, .3, .045), M.branco, 0, -.29, .05));
    p.add(malha(rb(.2, .03, .31, .012), M.sola, 0, -.335, .05));
    corpo.add(p); pernas.push(p);
  }
  // tronco (moletom ou jaleco)
  const tronco = malha(new THREE.CapsuleGeometry(.3, .26, 8, 20), o.jaleco ? M.branco : roupa, 0, .64, 0);
  tronco.scale.set(1, 1, .84);
  corpo.add(tronco);
  if (o.jaleco) {
    corpo.add(malha(new THREE.CylinderGeometry(.3, .37, .42, 24, 1, true), M.branco, 0, .34, 0));
    corpo.add(malha(rb(.15, .42, .05, .02), roupa, 0, .68, .245));          // camiseta colorida por dentro do jaleco
    corpo.add(malha(rb(.09, .05, .02, .01), luz(o.olho, .8), -.15, .62, .255)); // crachá
  } else {
    corpo.add(malha(new THREE.CylinderGeometry(.305, .3, .07, 24), barra, 0, .38, 0));
    corpo.add(malha(rb(.36, .15, .05, .03), tecido(new THREE.Color(o.cor).multiplyScalar(.86)), 0, .56, .235));
  }
  // braços
  const bracos = [];
  for (const s of [-1, 1]) {
    const b = new THREE.Group(); b.position.set(.31 * s, .82, 0); b.rotation.z = .22 * s;
    b.add(malha(new THREE.CapsuleGeometry(.082, .26, 6, 12), o.jaleco ? M.branco : roupa, 0, -.2, 0));
    b.add(malha(new THREE.CylinderGeometry(.085, .085, .05, 16), o.jaleco ? M.branco : barra, 0, -.37, 0));
    b.add(malha(new THREE.SphereGeometry(.07, 16, 12), M.casco, 0, -.42, 0));
    corpo.add(b); bracos.push(b);
  }
  // cabeça: casco branco, visor preto, olhos de luz
  const cabeca = new THREE.Group(); cabeca.position.set(0, 1.12, 0);
  const casco = malha(new THREE.SphereGeometry(.31, 32, 24), M.casco); casco.scale.set(1.06, .95, 1);
  cabeca.add(casco);
  const visor = malha(new THREE.SphereGeometry(.28, 32, 24), M.visor, 0, -.01, .1); visor.scale.set(1.08, .74, .78);
  cabeca.add(visor);
  const olhos = [];
  for (const s of [-1, 1]) {
    const e = malha(new THREE.CapsuleGeometry(.026, .07, 4, 10), olhoM, .095 * s, -.005, .305, false);
    e.scale.z = .35; olhos.push(e); cabeca.add(e);
  }
  if (o.capuz) {
    const gap = 1.9;
    const capuz = malha(new THREE.SphereGeometry(.4, 32, 20, Math.PI / 2 + gap / 2, Math.PI * 2 - gap, 0, 2.25), roupa, 0, .02, -.05);
    capuz.material = roupa.clone(); capuz.material.side = THREE.DoubleSide;
    cabeca.add(capuz);
    for (const s of [-1, 1]) {
      const c = malha(new THREE.CylinderGeometry(.009, .009, .24, 6), M.cordao, .07 * s, .84, .27);
      corpo.add(c);
      corpo.add(malha(new THREE.CylinderGeometry(.013, .013, .03, 6), M.metal, .07 * s, .71, .27));
    }
  }
  if (o.faixa) {
    const f = malha(new THREE.TorusGeometry(.315, .04, 10, 40), tecido(o.faixa), 0, .1, 0);
    f.rotation.x = Math.PI / 2 - .12; cabeca.add(f);
  }
  corpo.add(cabeca);
  raiz.userData = { corpo, cabeca, olhos, olhoM, bracos, pernas, piscar: 2 + Math.random() * 3, base: o.base || 0 };
  return raiz;
}
function sentar(b) {
  const u = b.userData;
  u.corpo.position.y = .14;
  u.pernas.forEach(p => { p.rotation.x = -Math.PI / 2; p.position.z = .1; p.position.y = .36; });
}

